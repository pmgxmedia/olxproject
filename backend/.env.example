# Database
# Development: SQLite (default, no setup needed)
DATABASE_URL=sqlite+aiosqlite:///tradeflex.db
# Production (PostgreSQL — set this in your Sevalla environment variables):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/tradeflex

# JWT Settings — generate a secure key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudinary (https://cloudinary.com/ — sign up for free)
# 1. Go to Dashboard > API Keys
# 2. Copy Cloud Name, API Key, and API Secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App Settings
# Set DEBUG=true only during local development
DEBUG=false
# Production: leave empty or set to your deployed frontend URL if frontend is a separate app
CORS_ORIGINS=https://your-app.sevalla.app